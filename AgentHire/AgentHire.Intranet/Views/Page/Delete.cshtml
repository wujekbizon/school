@model AgentHire.Data.Data.CMS.Page

@{
    ViewData["Title"] = "Delete Page";
}

<div class="container mt-4">
    <div class="alert alert-danger" role="alert">
        <h4 class="alert-heading">Confirm Deletion</h4>
        <p>Are you sure you want to delete this page? This action cannot be undone.</p>
    </div>

    <div class="card mx-auto shadow-sm" style="max-width: 600px;">
        <div class="card-body">
            <h5 class="card-title text-muted mb-3">Page Summary</h5>
            <dl class="row mb-0">
                <dt class="col-sm-4">Navigation Title</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.NavTitle)</dd>

                <dt class="col-sm-4">Full Title</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Title)</dd>

                <dt class="col-sm-4">Position Index</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Position)</dd>
            </dl>
        </div>
        <div class="card-footer">
            <form asp-action="Delete" class="d-flex justify-content-between align-items-center">
                <input type="hidden" asp-for="IdPage" />
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-danger">Delete Permanently</button>
            </form>
        </div>
    </div>
</div>