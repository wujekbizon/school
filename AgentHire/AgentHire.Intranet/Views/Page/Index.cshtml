@model IEnumerable<AgentHire.Data.Data.CMS.Page>

@{
    ViewData["Title"] = "Pages";
}

<div class="container">
    <div class="page-header">
        <h1>CMS Pages</h1>
        <a asp-action="Create" class="btn btn-primary">Create New Page</a>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.NavTitle)</th>
                <th>@Html.DisplayNameFor(model => model.Title)</th>
                <th>@Html.DisplayNameFor(model => model.Position)</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model) {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.NavTitle)</td>
                    <td>@Html.DisplayFor(modelItem => item.Title)</td>
                    <td>@Html.DisplayFor(modelItem => item.Position)</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@item.IdPage" class="btn btn-sm btn-primary">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.IdPage" class="btn btn-sm btn-outline">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.IdPage" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
