@model IEnumerable<AgentHire.Data.Data.Agents.Agent>

@{
    ViewData["Title"] = "Agents List";
}

<div class="container">
    <div class="page-header">
        <h1>Agents</h1>
        <a asp-action="Create" class="btn btn-primary">Create New Agent</a>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.FullName)</th>
                <th>@Html.DisplayNameFor(model => model.HourlyRate)</th>
                <th>@Html.DisplayNameFor(model => model.IsHighlighted)</th>
                <th>Specialization</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model) {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.FullName)</td>
                    <td>@Html.DisplayFor(modelItem => item.HourlyRate)</td>
                    <td>@Html.DisplayFor(modelItem => item.IsHighlighted)</td>
                    <td>@(item.Specialization?.Name)</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@item.IdAgent" class="btn btn-sm btn-primary">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.IdAgent" class="btn btn-sm btn-outline">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.IdAgent" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
