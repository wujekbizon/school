@model AgentHire.Data.Data.Agents.Agent

@{
    ViewData["Title"] = "Delete Agent";
}

<div class="container mt-4 text-center">
    <div class="card border-danger mx-auto" style="max-width: 500px;">
        <div class="card-header bg-danger text-white">
            <h2 class="h5 mb-0">Confirm Deletion</h2>
        </div>
        <div class="card-body">
            <p class="lead">Are you sure you want to delete this agent?</p>
            <div class="text-start mb-4">
                <strong>Name:</strong> @Html.DisplayFor(model => model.FullName)<br />
                <strong>Specialization:</strong> @(Model.Specialization?.Name)
            </div>

            <form asp-action="Delete">
                <input type="hidden" asp-for="IdAgent" />
                <button type="submit" class="btn btn-danger">Delete Permanentely</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>