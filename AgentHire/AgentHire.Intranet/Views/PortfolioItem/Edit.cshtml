@model AgentHire.Data.Data.Agents.PortfolioItem

@{
    ViewData["Title"] = "Edit Portfolio Item";
}

<div class="form-card">
    <h2>Edit Portfolio Item</h2>
    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="IdPortfolioItem" />

        <div class="form-group">
            <label asp-for="Title"></label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Description"></label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="ProjectUrl"></label>
            <input asp-for="ProjectUrl" class="form-control" />
            <span asp-validation-for="ProjectUrl" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="IdAgent">Assigned Agent</label>
            <select asp-for="IdAgent" class="form-select" asp-items="ViewBag.IdAgent"></select>
            <span asp-validation-for="IdAgent" class="text-danger"></span>
        </div>

        <div class="form-actions">
            <a asp-action="Index" class="btn btn-outline">Back to List</a>
            <button type="submit" class="btn btn-primary">Update Item</button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
