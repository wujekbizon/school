@model AgentHire.Data.Data.Agents.PortfolioItem

@{
    ViewData["Title"] = "Delete Portfolio Item";
}

<div class="container">
    <div class="alert alert-warning d-inline-block p-4 shadow-sm" style="max-width: 500px;">
        <h3>Delete Item?</h3>
        <p class="mb-4">Are you sure you want to permanently delete this portfolio item? This action cannot be undone.</p>
        
        <hr />
        
        <div class="mb-4 text-start">
            <strong>Title:</strong> @Model.Title <br />
            <strong>Agent:</strong> @Model.Agent?.FullName
        </div>

        <form asp-action="Delete">
            <input type="hidden" asp-for="IdPortfolioItem" />
            <button type="submit" class="btn btn-danger">Delete Permanently</button>
            <a asp-action="Index" class="btn btn-outline">Cancel</a>
        </form>
    </div>
</div>