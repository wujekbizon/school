@model IEnumerable<AgentHire.Data.Data.Agents.Specialization>

@{
    ViewData["Title"] = "Specializations";
}

<div class="page-header">
    <h1>Specializations</h1>
    <a asp-action="Create" class="btn btn-sm btn-primary">Create New</a>
</div>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model) {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Description)
                </td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@item.IdSpecialization" class="btn btn-sm btn-primary">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.IdSpecialization" class="btn btn-sm btn-outline">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.IdSpecialization" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
