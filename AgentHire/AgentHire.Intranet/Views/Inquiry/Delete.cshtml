@model AgentHire.Data.Data.Projects.Inquiry

@{
    ViewData["Title"] = "Delete Inquiry";
}

<div class="form-card">
    <h2>Delete Inquiry</h2>
    <p style="color:#e74c3c; margin-bottom:1.5rem;">Are you sure you want to delete this inquiry?</p>

    <div class="card">
        <dl>
            <dt>@Html.DisplayNameFor(m => m.SenderName)</dt>
            <dd>@Html.DisplayFor(m => m.SenderName)</dd>

            <dt>@Html.DisplayNameFor(m => m.Email)</dt>
            <dd>@Html.DisplayFor(m => m.Email)</dd>

            <dt>@Html.DisplayNameFor(m => m.SubmittedAt)</dt>
            <dd>@Html.DisplayFor(m => m.SubmittedAt)</dd>
        </dl>
    </div>

    <form asp-action="Delete" method="post" style="margin-top:1.5rem; display:flex; gap:0.75rem;">
        <input type="hidden" asp-for="IdInquiry" />
        <button type="submit" class="btn btn-danger">Confirm Delete</button>
        <a asp-action="Index" class="btn btn-outline">Cancel</a>
    </form>
</div>
