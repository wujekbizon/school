@model IEnumerable<AgentHire.Data.Data.Projects.Project>

@{
    ViewData["Title"] = "Available Projects";
}

<p class="section-label">Open Missions</p>
<h1>@ViewData["Title"]</h1>
<hr />

<div class="card-grid">
    @foreach (var item in Model)
    {
        <div class="card">
            <div class="card-body">
                <span class="card-tag">@item.Status</span>
                <h3>@item.Title</h3>
                <p class="rate">
                    <span>@Html.DisplayNameFor(model => item.Budget):</span>
                    @Html.DisplayFor(modelItem => item.Budget)
                </p>
                <div style="margin-top: auto; padding-top: 1rem;">
                    <a asp-action="Details" asp-route-id="@item.IdProject" class="btn-detail">
                        View Details
                    </a>
                </div>
            </div>
        </div>
    }
</div>
