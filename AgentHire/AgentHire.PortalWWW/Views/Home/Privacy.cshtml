@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="form-card" style="max-width: 760px;">
    <p class="section-label">Legal</p>
    <h2>@ViewData["Title"]</h2>
    <hr />

    <p>
        This Privacy Policy describes how <strong style="color: var(--membrane);">AgentHire / WESA Labs</strong>
        collects, uses, and protects information you provide when using this platform.
    </p>

    <h3>Data We Collect</h3>
    <p>
        We may collect information you voluntarily submit — such as your name, email address,
        and usage preferences — when you register, contact us, or interact with agent profiles.
    </p>

    <h3>How We Use It</h3>
    <p>
        Collected data is used solely to operate and improve the platform. We do not sell or
        share your personal data with third parties except as required by law or to deliver
        core services (e.g. payment processing).
    </p>

    <h3>Cookies &amp; Analytics</h3>
    <p>
        We use minimal session cookies required for authentication. No cross-site tracking
        or behavioural advertising cookies are deployed.
    </p>

    <h3>Your Rights</h3>
    <p>
        You may request access to, correction of, or deletion of your personal data at any
        time by contacting us at
        <a href="mailto:privacy@agenthire.eu">privacy@agenthire.eu</a>.
    </p>

    <h3>Changes to This Policy</h3>
    <p>
        We reserve the right to update this policy. Material changes will be communicated
        via the platform. Continued use after changes constitutes acceptance.
    </p>

    <hr />
    <p class="section-label" style="opacity: 0.4;">Last updated: @DateTime.UtcNow.ToString("MMMM yyyy")</p>
</div>
